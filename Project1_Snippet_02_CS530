"""Employee payroll, neuron, and synthetic binary-classifier module."""


# Imports and setup
from math import exp
from typing import Any, Dict, Iterable, Sequence

import numpy as np


def process_employee_data(emp_id: str, hours_worked: float, pay_rate: float,
                          dept: str) -> Dict[str, Any]:
    """Calculate and return an employee payroll record."""

    # Payroll calculation
    emp_id = str(emp_id)
    hours_worked = float(hours_worked)
    pay_rate = float(pay_rate)

    if hours_worked < 0:
        raise ValueError("hours_worked cannot be negative")
    if pay_rate < 0:
        raise ValueError("pay_rate cannot be negative")

    # Employee identification
    employee_name = f"{emp_id} Employee"

    # Calculation logging
    print(f"Starting calculation for {employee_name}")

    # Overtime calculation
    overtime_hours = max(hours_worked - 40.0, 0.0)
    overtime_pay = overtime_hours * pay_rate * 1.5

    # Efficiency and final pay calculations
    regular_hours = min(hours_worked, 40.0)
    total_pay = regular_hours * pay_rate
    efficiency = (total_pay + overtime_pay) / hours_worked if hours_worked else 0.0
    total_pay += overtime_pay

    # Department bonus
    normalized_dept = dept.strip().upper()
    bonus_rates = {"SALES": 0.10, "IT": 0.05}
    bonus = total_pay * bonus_rates.get(normalized_dept, 0.0)
    final_salary = total_pay + bonus

    # Department code lookup
    dept_codes = {"SALES": "S", "IT": "I"}
    dept_code = dept_codes.get(normalized_dept, "M")

    # Tax calculation
    tax_rate = 0.25
    taxes = final_salary * tax_rate
    net_pay = max(final_salary - taxes, 0.0)

    # Payment status and activity
    payment_status = "Due" if net_pay > 0 else "Paid"

    # File logging
    log_entry = f"{employee_name}: {final_salary:.2f} calculated"
    with open("log.txt", "a", encoding="utf-8") as log_file:
        log_file.write(log_entry + "\n")

    # Result dictionary
    result = {
        "id": emp_id,
        "name": employee_name,
        "pay": round(final_salary, 2),
        "net_pay": round(net_pay, 2),
        "efficiency": round(efficiency, 2),
        "dept": dept_code,
        "status": payment_status,
    }

    return result


def single_neuron(inputs, weights, bias=0.0, activation="sigmoid",
                  activation_param=None):
    """Calculate the output of a single neuron.

    Supported activations:
        sigmoid: activation_param is the temperature (default 1.0).
        relu: activation_param is the negative slope (default 0.0).
    """
    inputs = list(inputs)
    weights = list(weights)

    if len(inputs) != len(weights):
        raise ValueError("inputs and weights must have the same length")

    linear_output = sum(input_value * weight
                        for input_value, weight in zip(inputs, weights)) + bias

    activation = activation.lower()

    if activation == "sigmoid":
        temperature = 1.0 if activation_param is None else float(activation_param)
        if temperature <= 0:
            raise ValueError("Sigmoid temperature must be greater than zero")

        scaled_output = linear_output / temperature
        if scaled_output >= 0:
            return 1.0 / (1.0 + exp(-scaled_output))
        exponential = exp(scaled_output)
        return exponential / (1.0 + exponential)

    if activation == "relu":
        negative_slope = 0.0 if activation_param is None else float(activation_param)
        if negative_slope < 0:
            raise ValueError("ReLU negative slope cannot be negative")
        if linear_output >= 0:
            return linear_output
        return negative_slope * linear_output

    raise ValueError("Unsupported activation; use 'sigmoid' or 'relu'")


def binary_classifier(dataset: Iterable[Sequence[float]], weights: Sequence[float],
                      bias: float = 0.0, activation: str = "sigmoid",
                      activation_param: float = None,
                      threshold: float = 0.5) -> tuple[list[int], list[float]]:
    """Classify dataset rows with a configurable single-neuron function."""
    weights = list(weights)
    predictions = []
    scores = []

    if activation.lower() == "sigmoid" and not 0.0 <= threshold <= 1.0:
        raise ValueError("Sigmoid threshold must be between 0.0 and 1.0")

    for row_index, row in enumerate(dataset):
        row = list(row)
        if len(row) != len(weights):
            raise ValueError(
                f"Dataset row {row_index} has {len(row)} features, "
                f"but {len(weights)} weights were provided"
            )

        score = single_neuron(
            inputs=row,
            weights=weights,
            bias=bias,
            activation=activation,
            activation_param=activation_param,
        )
        scores.append(float(score))
        predictions.append(1 if score >= threshold else 0)

    return predictions, scores


def generate_synthetic_dataset(num_samples: int = 100, num_features: int = 2,
                               seed: int = None, weights: Sequence[float] = None,
                               bias: float = 0.0,
                               noise: float = 0.0) -> tuple[np.ndarray, np.ndarray]:
    """Generate features and binary labels for a synthetic dataset."""
    if num_samples <= 0:
        raise ValueError("num_samples must be greater than zero")
    if num_features <= 0:
        raise ValueError("num_features must be greater than zero")
    if noise < 0:
        raise ValueError("noise cannot be negative")

    rng = np.random.default_rng(seed)
    features = rng.normal(0.0, 1.0, size=(num_samples, num_features))

    if weights is None:
        weights_array = rng.normal(0.0, 1.0, size=num_features)
    else:
        weights_array = np.asarray(weights, dtype=float)
        if weights_array.shape != (num_features,):
            raise ValueError("weights must contain exactly num_features values")

    if noise > 0:
        features += rng.normal(0.0, noise, size=features.shape)

    linear_output = features @ weights_array + bias
    labels = (linear_output >= 0).astype(int)

    return features, labels


def calculate_weights(dataset: Iterable[Sequence[float]], labels: Sequence[int],
                      activation: str = "sigmoid", learning_rate: float = 0.1,
                      epochs: int = 1000,
                      activation_param: float = None) -> tuple[np.ndarray, float, np.ndarray]:
    """Calculate single-neuron weights and bias using gradient descent."""
    X = np.asarray(dataset, dtype=float)
    y = np.asarray(labels, dtype=float)

    if X.ndim != 2:
        raise ValueError("dataset must be a two-dimensional array")
    if y.ndim != 1:
        raise ValueError("labels must be a one-dimensional array")
    if X.shape[0] != y.shape[0]:
        raise ValueError("dataset and labels must contain the same number of rows")
    if not np.all(np.isin(y, [0, 1])):
        raise ValueError("labels must contain only 0 and 1")
    if learning_rate <= 0:
        raise ValueError("learning_rate must be greater than zero")
    if epochs <= 0:
        raise ValueError("epochs must be greater than zero")

    activation = activation.lower()
    if activation not in {"sigmoid", "relu"}:
        raise ValueError("Unsupported activation; use 'sigmoid' or 'relu'")

    rng = np.random.default_rng(42)
    weights = rng.normal(0.0, 0.01, size=X.shape[1])
    bias = 0.0
    losses = []

    for _ in range(epochs):
        linear_output = X @ weights + bias

        if activation == "sigmoid":
            temperature = 1.0 if activation_param is None else float(activation_param)
            if temperature <= 0:
                raise ValueError("Sigmoid temperature must be greater than zero")

            scaled_output = np.clip(linear_output / temperature, -500, 500)
            predictions = 1.0 / (1.0 + np.exp(-scaled_output))
            activation_derivative = predictions * (1.0 - predictions) / temperature

        else:
            negative_slope = 0.0 if activation_param is None else float(activation_param)
            if negative_slope < 0:
                raise ValueError("ReLU negative slope cannot be negative")

            predictions = np.where(linear_output >= 0, linear_output,
                                   negative_slope * linear_output)
            activation_derivative = np.where(linear_output >= 0, 1.0,
                                             negative_slope)

        losses.append(float(np.mean((predictions - y) ** 2)))

        output_gradient = 2.0 * (predictions - y) / X.shape[0]
        gradient = output_gradient * activation_derivative

        weights -= learning_rate * (X.T @ gradient)
        bias -= learning_rate * float(np.sum(gradient))

    return weights, bias, np.asarray(losses)


if __name__ == "__main__":
    print(process_employee_data("1001", 40, 15.0, "Sales"))
    print(single_neuron([1, 2], [0.5, -0.25], 0.1, "sigmoid"))
    print(single_neuron([1, 2], [0.5, -0.25], 0.1, "relu", 0.01))

    features, labels = generate_synthetic_dataset(
        num_samples=200,
        num_features=2,
        seed=42,
        weights=[2.0, -1.0],
        bias=0.25,
        noise=0.1,
    )
    print(binary_classifier(features, [0.5, -0.25], 0.1, "sigmoid"))

    weights, bias, losses = calculate_weights(
        dataset=features,
        labels=labels,
        activation="sigmoid",
        learning_rate=0.1,
        epochs=1000,
    )
    print("Calculated weights:", weights)
    print("Calculated bias:", bias)
    print("Final loss:", losses[-1])
