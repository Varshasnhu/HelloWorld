# Program Entry Point
# ==========================
if __name__ == "__main__":
    # Demonstrate payroll and neuron calculations.
    print(process_employee_data("1001", 40, 15.0, "Sales"))
    print(single_neuron([1, 2], [0.5, -0.25], 0.1, "sigmoid"))
    print(single_neuron([1, 2], [0.5, -0.25], 0.1, "relu", 0.01))

    # Generate one reproducible synthetic dataset for both activation runs.
    features, labels = generate_synthetic_dataset(
        num_samples=200,
        num_features=2,
        seed=42,
        weights=[2.0, -1.0],
        bias=0.25,
        noise=0.1,
    )

    print("Synthetic dataset shape:", features.shape)
    print("Positive label fraction:", float(np.mean(labels)))

    # Train once with sigmoid and once with ReLU on the same dataset.
    for activation_name in ("sigmoid", "relu"):
        trained_weights, trained_bias, losses = calculate_weights(
            dataset=features,
            labels=labels,
            activation=activation_name,
            learning_rate=0.1,
            epochs=1000,
        )

        print(f"{activation_name} weights:", trained_weights)
        print(f"{activation_name} bias:", trained_bias)
        print(f"{activation_name} final MSE:", losses[-1])
