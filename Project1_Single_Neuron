# === Imports ===
import numpy as np


# === Single-Neuron Forward Pass ===
def single_neuron(inputs, weights, bias, activation="sigmoid"):
    """Calculate the activated output of one neuron."""
    inputs = np.asarray(inputs, dtype=float)
    weights = np.asarray(weights, dtype=float)

    if weights.ndim != 1:
        raise ValueError("weights must be a 1-D array")

    if inputs.ndim == 1:
        if inputs.shape[0] != weights.shape[0]:
            raise ValueError("inputs and weights must have the same length")
        weighted_sum = np.dot(inputs, weights) + bias
    elif inputs.ndim == 2:
        if inputs.shape[1] != weights.shape[0]:
            raise ValueError("Each input row must match the weight count")
        weighted_sum = np.dot(inputs, weights) + bias
    else:
        raise ValueError("inputs must be a 1-D or 2-D array")

    if not isinstance(activation, str):
        raise ValueError("activation must be 'sigmoid' or 'relu'")

    activation = activation.lower()
    if activation == "sigmoid":
        weighted_sum = np.clip(weighted_sum, -500, 500)
        return 1.0 / (1.0 + np.exp(-weighted_sum))
    if activation == "relu":
        return np.maximum(0.0, weighted_sum)

    raise ValueError("activation must be 'sigmoid' or 'relu'")


# === Binary Classification ===
def binary_classifier(dataset, weights, activation="sigmoid", bias=0.0,
                     threshold=0.5):
    """Convert neuron scores into binary class predictions."""
    dataset = np.asarray(dataset, dtype=float)
    if dataset.ndim != 2:
        raise ValueError("dataset must be a 2-D array")

    scores = single_neuron(dataset, weights, bias, activation)

    # Sigmoid scores are probabilities, so 0.5 is a natural threshold.
    # ReLU scores are unbounded; use the supplied threshold or adjust it.
    return (scores >= threshold).astype(int)


# === Weight and Bias Training ===
def train_binary_classifier(dataset, labels, activation="sigmoid",
                            learning_rate=0.1, epochs=1000,
                            random_state=None):
    """Train a single neuron using full-batch gradient descent.

    Sigmoid uses binary cross-entropy.
    ReLU uses mean squared error.
    """
    dataset = np.asarray(dataset, dtype=float)
    labels = np.asarray(labels, dtype=float).reshape(-1)

    if dataset.ndim != 2 or dataset.shape[0] == 0 or dataset.shape[1] == 0:
        raise ValueError("dataset must be a non-empty 2-D array")
    if labels.shape[0] != dataset.shape[0]:
        raise ValueError("labels must contain one value per dataset row")
    if not np.all(np.isfinite(dataset)) or not np.all(np.isfinite(labels)):
        raise ValueError("dataset and labels must contain only finite values")
    if not np.all(np.isin(labels, [0.0, 1.0])):
        raise ValueError("labels must contain only 0 and 1")
    if not isinstance(activation, str) or activation.lower() not in ("sigmoid", "relu"):
        raise ValueError("activation must be 'sigmoid' or 'relu'")

    activation = activation.lower()
    if learning_rate <= 0:
        raise ValueError("learning_rate must be positive")
    if not isinstance(epochs, int) or epochs <= 0:
        raise ValueError("epochs must be a positive integer")

    rng = np.random.default_rng(random_state)
    weights = rng.normal(0.0, 0.1, size=dataset.shape[1])
    bias = 0.0
    loss_history = []

    for _ in range(epochs):
        weighted_sum = dataset @ weights + bias

        if activation == "sigmoid":
            clipped_sum = np.clip(weighted_sum, -500, 500)
            predictions = 1.0 / (1.0 + np.exp(-clipped_sum))
            epsilon = 1e-12
            safe_predictions = np.clip(predictions, epsilon, 1.0 - epsilon)
            loss = -np.mean(labels * np.log(safe_predictions)
                            + (1.0 - labels) * np.log(1.0 - safe_predictions))
            loss_gradient = (predictions - labels) / dataset.shape[0]

        else:
            predictions = np.maximum(0.0, weighted_sum)
            loss = np.mean((predictions - labels) ** 2)
            activation_gradient = (weighted_sum > 0.0).astype(float)
            loss_gradient = (
                2.0 / dataset.shape[0]
                * (predictions - labels)
                * activation_gradient
            )

        loss_history.append(float(loss))

        if activation == "sigmoid":
            weight_gradient = dataset.T @ loss_gradient
            bias_gradient = np.sum(loss_gradient)
        else:
            weight_gradient = dataset.T @ loss_gradient
            bias_gradient = np.sum(loss_gradient)

        weights -= learning_rate * weight_gradient
        bias -= learning_rate * bias_gradient

    return weights, float(bias), loss_history


# === Synthetic Dataset Generation ===
def make_synthetic_dataset(n_samples=100, n_features=2, label_noise=0.0,
                           random_state=None):
    """Generate binary data around a reproducible linear boundary."""
    if n_samples <= 0:
        raise ValueError("n_samples must be positive")
    if n_features <= 0:
        raise ValueError("n_features must be positive")
    if not 0.0 <= label_noise <= 1.0:
        raise ValueError("label_noise must be between 0.0 and 1.0")

    rng = np.random.default_rng(random_state)
    features = rng.normal(size=(n_samples, n_features))
    true_weights = rng.normal(size=n_features)
    true_bias = rng.uniform(-0.5, 0.5)

    labels = (features @ true_weights + true_bias >= 0).astype(int)
    if label_noise > 0.0:
        flip_labels = rng.random(n_samples) < label_noise
        labels[flip_labels] = 1 - labels[flip_labels]

    return features, labels, true_weights, true_bias


# === Training and Activation Comparison ===
synthetic_X, synthetic_y, _, _ = make_synthetic_dataset(
    n_samples=100,
    n_features=2,
    label_noise=0.0,
    random_state=42,
)

for activation_name in ("sigmoid", "relu"):
    threshold = 0.5 if activation_name == "sigmoid" else 0.5

    learned_weights, learned_bias, loss_history = train_binary_classifier(
        synthetic_X,
        synthetic_y,
        activation=activation_name,
        learning_rate=0.5,
        epochs=2000,
        random_state=42,
    )
    predictions = binary_classifier(
        synthetic_X,
        learned_weights,
        activation=activation_name,
        bias=learned_bias,
        threshold=threshold,
    )

    print(f"\nActivation: {activation_name}")
    print("Learned weights:", learned_weights)
    print("Learned bias:", learned_bias)
    print("Initial loss:", loss_history[0])
    print("Final loss:", loss_history[-1])
    print("Synthetic dataset accuracy:", np.mean(predictions == synthetic_y))
